# Konfiguracija Torvina. Kopiraj u .env (cp .env.example .env). .env se ne commituje.
# Vrijednosti su za lokalni rad (localhost). docker-compose.yml za kontejnere sam zamijeni adrese servisa.
# Znak $ ne koristi u vrijednostima, jer ga docker compose tumači kao varijablu.

ASPNETCORE_ENVIRONMENT=Development

# API (lokalni port, a u Dockeru port na računaru koji vodi na API)
API_PORT=5080
CORS_ORIGINS=http://localhost:5080

# Baza (SQL Server). Lozinka mora imati najmanje 8 znakova, veliko i malo slovo, broj i simbol,
# inače SQL Server kontejner ne starta.
SQL_SA_PASSWORD=Torvin_Dev_2026!
DB_HOST=localhost
DB_PORT=1401
DB_NAME=230181

# JWT (ključ najmanje 32 znaka)
JWT_KEY=torvin-dev-jwt-kljuc-samo-za-razvoj-2026
JWT_ISSUER=torvin
JWT_AUDIENCE=torvin
JWT_EXPIRES_MINUTES=60

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=torvin
RABBITMQ_PASSWORD=torvin_dev

# SMTP (Mailpit u razvoju ne traži korisnika ni lozinku)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_SSL=false
SMTP_FROM=no-reply@torvin.local

# AI asistent
AI_API_KEY=
AI_MODEL=
