# Ručna provjera auth toka (VS Code REST Client ili Rider/Visual Studio).
# Pokrenuti stack: docker compose up -d --build. Mailovi stižu u Mailpit: http://localhost:8025
@baseUrl = http://localhost:5080
@email = novi.korisnik@torvin.local
@password = Torvin.2026!

### 1. Registracija (201, kod stiže u Mailpit)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "firstName": "Novi",
  "lastName": "Korisnik",
  "username": "novi.korisnik",
  "email": "{{email}}",
  "phoneNumber": "+387 61 234 567",
  "password": "{{password}}",
  "confirmPassword": "{{password}}"
}

### 2. Prijava prije potvrde (403, šalje novi kod najviše jednom u 60 s)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "login": "novi.korisnik", "password": "{{password}}", "app": "Mobile" }

### 3. Potvrda emaila: kod iz posljednjeg maila u Mailpitu (204)
POST {{baseUrl}}/auth/verify-email
Content-Type: application/json

{ "email": "{{email}}", "code": "000000" }

### 4. Prijava (200, token za korake 5 i 6)
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "login": "novi.korisnik", "password": "{{password}}", "app": "Mobile" }

### 5. Odjava važećim tokenom (204)
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{login.response.body.token}}

### 6. Isti token poslije odjave (401)
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{login.response.body.token}}

### 7. Zaboravljena lozinka (uvijek 204, kod stiže samo za postojeći aktivan račun)
POST {{baseUrl}}/auth/forgot-password
Content-Type: application/json

{ "email": "{{email}}" }

### 8. Reset kodom iz maila (204). Nova lozinka ne smije biti jedna od zadnje tri
POST {{baseUrl}}/auth/reset-password
Content-Type: application/json

{ "email": "{{email}}", "code": "000000", "newPassword": "Torvin.2027!", "confirmPassword": "Torvin.2027!" }

### 9. Prijava novom lozinkom (200)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "login": "{{email}}", "password": "Torvin.2027!", "app": "Mobile" }

# ---------- Kartice (seed korisnik mobile/test). Kod za aktivaciju stiže u Mailpit

### 10. Prijava korisnika (200)
# @name mobile
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "login": "mobile", "password": "test", "app": "Mobile" }

### 11. Nova kartica (201, status Pending). Pun broj se samo provjerava, čuvaju se zadnje 4 cifre i mreža
# @name card
POST {{baseUrl}}/cards
Authorization: Bearer {{mobile.response.body.token}}
Content-Type: application/json

{ "cardTypeId": 1, "currencyId": 1, "name": "Online kupovina", "cardNumber": "5555555555554444", "expiry": "08/29" }

### 12. Aktivacija kodom iz posljednjeg maila u Mailpitu (200, status Active)
POST {{baseUrl}}/cards/{{card.response.body.id}}/verify
Authorization: Bearer {{mobile.response.body.token}}
Content-Type: application/json

{ "code": "000000" }

### 13. Blokiranje (200, status Blocked)
POST {{baseUrl}}/cards/{{card.response.body.id}}/block
Authorization: Bearer {{mobile.response.body.token}}

### 14. Deblokiranje (200, status Active)
POST {{baseUrl}}/cards/{{card.response.body.id}}/unblock
Authorization: Bearer {{mobile.response.body.token}}

### 15. Prijava krađe (200, status Stolen, konačno)
POST {{baseUrl}}/cards/{{card.response.body.id}}/report
Authorization: Bearer {{mobile.response.body.token}}
Content-Type: application/json

{ "reason": "Stolen", "note": "Ukradena u tramvaju." }

### 16. Deblokiranje ukradene kartice (400, "Kartica prijavljena kao ukradena ne može se ponovo aktivirati.")
POST {{baseUrl}}/cards/{{card.response.body.id}}/unblock
Authorization: Bearer {{mobile.response.body.token}}

### 17. Moje kartice, nova je prva (200)
GET {{baseUrl}}/cards?page=1&pageSize=20
Authorization: Bearer {{mobile.response.body.token}}

### 18. Prijava administratora (200)
# @name desktop
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "login": "desktop", "password": "test", "app": "Desktop" }

### 19. Sve kartice, filter po statusu Blocked (200)
GET {{baseUrl}}/admin/cards?cardStatusId=3
Authorization: Bearer {{desktop.response.body.token}}

### 20. Admin zatvara ukradenu karticu (200 kad je balans 0, inače 400)
PUT {{baseUrl}}/admin/cards/{{card.response.body.id}}/status
Authorization: Bearer {{desktop.response.body.token}}
Content-Type: application/json

{ "cardStatusId": 6, "reason": "Zatvaranje poslije prijave krađe." }
