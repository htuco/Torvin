<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Torvin.Model\Torvin.Model.csproj" />
  </ItemGroup>

  <!-- IHttpContextAccessor i IMemoryCache za servise koji čitaju prijavljenog korisnika -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Torvin.Tests" />
  </ItemGroup>

  <!-- Slike za seed su dio dll-a, pa ih API ima i u Docker imageu bez dodatnih fajlova -->
  <ItemGroup>
    <EmbeddedResource Include="Seed\Images\*.jpg" LogicalName="SeedImages.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.19.2" />
  </ItemGroup>

  <!-- Microsoft.Data.SqlClient (preko EF SqlServer) povlači ranjiv Pkcs 9.0.11, pa se zakrpljena verzija navodi direktno -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

</Project>
